generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  teacher
  admin
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  role           Role      @default(student)

  accounts    Account[]
  sessions    Session[]
  reports     Report[]
  cours       Cours[]
  busines     Busines[]
  achatCours  AchatCours[]
  progression Progression[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Categorie {
  id        String    @id @default(cuid())
  nom       String
  imageUrl  String?  
  imageId   String?
  usercreat String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Report {
  id        String   @id @default(cuid())
  title     String
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cours {
  id          String   @id @default(uuid())
  titre       String
  description String
  imageUrl    String
  publicId    String
  prix        Float
  categorie   String
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime @default(now())

  sousTitres  SousTitre[]
  achatCours  AchatCours[]
  progression Progression[]
}

model SousTitre {
  id          String   @id @default(uuid())
  titre       String
  description String
  videoUrl    String
  publicId    String
  coursId     String
  createdAt   DateTime @default(now())
  cours       Cours    @relation(fields: [coursId], references: [id])
}

model Busines {
  id            String   @id @default(uuid())
  titre         String
  prix          Float
  categorie     String
  description   String
  zipUrl        String
  zipPublicId   String
  imageUrl      String
  imagePublicId String
  introUrl      String
  introPublicId String
  userId        String
  lectures      Int      @default(0)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
}

model AchatCours {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  cours     Cours    @relation(fields: [coursId], references: [id])
  coursId   String
  createdAt DateTime @default(now())
}

model Progression {
  id      String   @id @default(uuid())
  userId  String
  coursId String
  videoId String
  date    DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  cours Cours @relation(fields: [coursId], references: [id])
}

model Video {
  id                String    @id @default(cuid())
  title             String
  description       String
  videoUrl          String
  videoPublicId     String
  thumbnail         String
  thumbnailPublicId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

